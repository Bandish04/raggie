#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Fake `.raggie/compose` for the backup/restore tests. Logs every call to
# $FAKE_LOG and answers the few commands the scripts use:
#   FAKE_RUNNING      services in state "running" (default: the datastores)
#   FAKE_STATES       extra "service=state" pairs (restarting, created, exited, ...)
#   FAKE_STATES_AFTER_UP  "service=state" pairs reported once `up` has run
#   FAKE_PS_FAIL      1: every `ps` fails
#   FAKE_PS_ARRAY     1: `ps --format json` prints one JSON array (older compose)
#   FAKE_TAMPER_ON_UP a file `up` appends to (a change after verification)
#   FAKE_FP           system_settings.embedding_fingerprint (default 2872ae6a)
#   FAKE_GATEWAY_FP   fingerprint the embeddings gateway reports (default FAKE_FP)
#   FAKE_STATE        dir for side effects (restored.dump)
set -euo pipefail
printf 'compose %s\n' "$*" >>"$FAKE_LOG"
fp="${FAKE_FP-2872ae6a}"
states() { # "service state" lines
  local s pair
  # shellcheck disable=SC2086 # one service per word
  for s in ${FAKE_RUNNING-postgres redis qdrant objectstore}; do echo "$s running"; done
  for pair in ${FAKE_STATES:-}; do echo "${pair%%=*} ${pair#*=}"; done
  if [[ -e "$FAKE_STATE/up-called" ]]; then
    for pair in ${FAKE_STATES_AFTER_UP:-}; do echo "${pair%%=*} ${pair#*=}"; done
  fi
}
if [[ "$1" == ps && "${FAKE_PS_FAIL:-0}" == 1 ]]; then
  echo "fake compose: cannot connect to the Docker daemon" >&2
  exit 1
fi
case "$*" in
  "ps --services --status running") states | awk '$2 == "running" {print $1}' ;;
  "ps -a --format json")
    states | python3 -c '
import json, os, sys
rows = [{"Service": s, "State": st, "Name": "fakeproj-" + s + "-1"}
        for s, st in (line.split() for line in sys.stdin if line.strip())]
if os.environ.get("FAKE_PS_ARRAY") == "1":
    print(json.dumps(rows))
else:
    for r in rows:
        print(json.dumps(r))'
    ;;
  "ps -q objectstore") echo cid-objectstore ;;
  up\ *)
    : >"$FAKE_STATE/up-called"
    [[ -z "${FAKE_TAMPER_ON_UP:-}" ]] || printf 'tampered' >>"$FAKE_TAMPER_ON_UP"
    ;;
  *"pg_dump"*) printf 'PGDUMP-CONTENT\n' ;;
  *"pg_restore"*) cat >"$FAKE_STATE/restored.dump" ;;
  *psql*)
    sql="${*: -1}"
    case "$sql" in
      *schema_migrations*) echo 0027 ;;
      *embedding_profile*) echo raggie_chunks_d1024 ;;
      *embedding_fingerprint*) echo "$fp" ;;
      *"FROM documents"*) echo 3 ;;
      *"FROM users"*) echo 2 ;;
      *"FROM workspaces"*) echo 1 ;;
      *) echo "unexpected sql: $sql" >&2; exit 1 ;;
    esac
    ;;
  *"exec -T embeddings"*)
    printf '{"provider":"local","fingerprint":"%s","collection":"raggie_chunks_d1024"}\n' \
      "${FAKE_GATEWAY_FP:-$fp}"
    ;;
  *raggie_control_plane.reindex*) echo '{"reindexed": 3, "skipped": 0}' ;;
  *) echo "fake compose: unexpected: $*" >&2; exit 1 ;;
esac
