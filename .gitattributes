# Normalize line endings: LF in the repo, regardless of OS checkout.
# Critical for shell scripts and Dockerfiles that must run on Linux.
* text=auto eol=lf

# Shell scripts and container files MUST be LF.
*.sh    text eol=lf
*.bash  text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
Makefile        text eol=lf

# Source files: LF.
*.go    text eol=lf
*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.jsx   text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.sql   text eol=lf
*.md    text eol=lf
*.proto text eol=lf

# Binary assets: never normalize.
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.woff  binary
*.woff2 binary
